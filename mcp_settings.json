{
  "mcpServers": {
    "ssh-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "../ssh-mcp/build/index.js",
        "--host=127.0.0.1",
        "--port=22",
        "--user=paul",
        "--key=/home/paul/.ssh/id_ed25519",
        "--insecureHostKey",
        "--group=dev",
        "--disableApproval"
      ],
      "env": {
        "SSH_MCP_PASSWORD": "1234",
        "SSH_MCP_SUDO_PASSWORD": "1234"
      },
      "enabled": true
    }
  },
  "users": [
    {
      "username": "admin",
      "password": "$2b$10$wfXBxWMnkIUvcsYw3AXFDu5.62hTIQh37cEKHUXzx.u8PWyPyR30e",
      "isAdmin": true
    }
  ],
  "systemConfig": {
    "routing": {
      "skipAuth": true,
      "enableBearerAuth": false
    },
    "oauthServer": {
      "enabled": true,
      "accessTokenLifetime": 3600,
      "refreshTokenLifetime": 1209600,
      "authorizationCodeLifetime": 300,
      "requireClientSecret": false,
      "allowedScopes": [
        "read",
        "write"
      ],
      "requireState": false,
      "dynamicRegistration": {
        "enabled": true,
        "allowedGrantTypes": [
          "authorization_code",
          "refresh_token"
        ],
        "requiresAuthentication": false
      }
    }
  },
  "bearerKeys": [],
  "prompts": [],
  "resources": []
}
